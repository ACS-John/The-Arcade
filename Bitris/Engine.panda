! Bitris rules. Included by the game and the headless regression program.
! Board rows 1-2 are hidden; 3-22 are the twenty visible rows.
dim board(22,10),shapeX(7,4,4),shapeY(7,4,4),bag(7)
dim awards(4),kickX(7),kickY(7)

InitRules: !
  restore Shapes
  for kind=1 to 7
    for block=1 to 4
      read shapeX(kind,1,block),shapeY(kind,1,block)
    next block
    pivot=1
    if kind=1 then pivot=1.5
    for turn=2 to 4
      for block=1 to 4
        shapeX(kind,turn,block)=2*pivot-shapeY(kind,turn-1,block)
        shapeY(kind,turn,block)=shapeX(kind,turn-1,block)
        if kind=2 then
          shapeX(kind,turn,block)=shapeX(kind,1,block)
          shapeY(kind,turn,block)=shapeY(kind,1,block)
        end if
      next block
    next turn
  next kind
  awards(1)=100 : awards(2)=300 : awards(3)=500 : awards(4)=800
  kickX(1)=0 : kickX(2)=-1 : kickX(3)=1 : kickX(4)=-2 : kickX(5)=2 : kickX(6)=0 : kickX(7)=0
  kickY(1)=0 : kickY(2)=0 : kickY(3)=0 : kickY(4)=0 : kickY(5)=0 : kickY(6)=-1 : kickY(7)=-2
return
Shapes: ! I O T S Z J L; zero-based offsets inside a four-cell box.
data 0,1,1,1,2,1,3,1
data 1,0,2,0,1,1,2,1
data 1,0,0,1,1,1,2,1
data 1,0,2,0,0,1,1,1
data 0,0,1,0,1,1,2,1
data 0,0,0,1,1,1,2,1
data 2,0,0,1,1,1,2,1

NewGame: !
  mat board=(0)
  score=0 : lineCount=0 : level=1 : gameOver=0 : held=0 : holdUsed=0
  bagPos=8 : gosub TakeBag : nextPiece=drawn
  gosub SpawnNext
return

TakeBag: ! Fisher-Yates: every seven draws contain all seven shapes.
  if bagPos>7 then
    for bagIdx=1 to 7
      bag(bagIdx)=bagIdx
    next bagIdx
    for bagIdx=7 to 2 step -1
      swapIdx=1+int(rnd*bagIdx)
      swapPiece=bag(bagIdx) : bag(bagIdx)=bag(swapIdx) : bag(swapIdx)=swapPiece
    next bagIdx
    bagPos=1
  end if
  drawn=bag(bagPos) : bagPos=bagPos+1
return

SpawnNext: !
  piece=nextPiece : gosub TakeBag : nextPiece=drawn
  holdUsed=0
  gosub SpawnPosition
return
SpawnPosition: !
  px=4 : py=1 : rotation=1 : lockSince=0 : lockResets=0
  lastFall=timer
  if fn_fits(piece,rotation,px,py)=0 then gameOver=1
return

def fn_fits(pk,rt,xx,yy;bb,bx,by,ok)
  ok=1
  for bb=1 to 4
    bx=xx+shapeX(pk,rt,bb) : by=yy+shapeY(pk,rt,bb)
    if bx<1 or bx>10 or by<1 or by>22 then
      ok=0
    else
      if board(by,bx)<>0 then ok=0
    end if
  next bb
  fn_fits=ok
fnend

MoveSide: ! dx is -1 or +1. Failed moves do not reset the lock delay.
  if fn_fits(piece,rotation,px+dx,py) then
    px=px+dx : gosub ResetLock
  end if
return
RotatePiece: ! direction is -1 or +1; modest wall and floor kicks.
  candidate=mod(rotation-1+direction+4,4)+1
  for kick=1 to 7
    if fn_fits(piece,candidate,px+kickX(kick),py+kickY(kick)) then
      px=px+kickX(kick) : py=py+kickY(kick) : rotation=candidate
      gosub ResetLock
      goto RotationDone
    end if
  next kick
RotationDone: !
return
ResetLock: ! Fifteen grounded adjustments per piece, then it must lock.
  if lockSince>0 and lockResets<15 then
    lockSince=timer : lockResets=lockResets+1
  end if
return

SoftDrop: !
  if fn_fits(piece,rotation,px,py+1) then
    py=py+1 : score=score+1 : lastFall=timer
  end if
return
FindGhost: !
  ghostY=py
  do while fn_fits(piece,rotation,px,ghostY+1)
    ghostY=ghostY+1
  loop
return
HardDrop: !
  gosub FindGhost
  score=score+2*(ghostY-py) : py=ghostY
  gosub LockPiece
return
HoldPiece: ! One hold per falling piece, including the initial empty hold.
  if holdUsed=0 then
    exchange=held : held=piece
    if exchange=0 then
      gosub SpawnNext
    else
      piece=exchange : gosub SpawnPosition
    end if
    holdUsed=1
  end if
return

TickGame: ! Wall-clock gravity; no catch-up cascade after a pause/stall.
  if gameOver=0 then
    if timer-lastFall>=max(.08,.8*(.82**(level-1))) then
      if fn_fits(piece,rotation,px,py+1) then py=py+1
      lastFall=timer
    end if
    if fn_fits(piece,rotation,px,py+1) then
      lockSince=0
    else
      if lockSince=0 then lockSince=timer
      if timer-lockSince>=.45 then gosub LockPiece
    end if
  end if
return

LockPiece: !
  for block=1 to 4
    bx=px+shapeX(piece,rotation,block) : by=py+shapeY(piece,rotation,block)
    board(by,bx)=piece
  next block
  gosub ClearLines
  gosub SpawnNext
return
ClearLines: ! Compact from bottom to top; recheck the row after each shift.
  cleared=0 : scanRow=22
  do while scanRow>=1
    full=1
    for scanCol=1 to 10
      if board(scanRow,scanCol)=0 then full=0
    next scanCol
    if full then
      cleared=cleared+1
      for copyRow=scanRow to 2 step -1
        for scanCol=1 to 10
          board(copyRow,scanCol)=board(copyRow-1,scanCol)
        next scanCol
      next copyRow
      for scanCol=1 to 10
        board(1,scanCol)=0
      next scanCol
    else
      scanRow=scanRow-1
    end if
  loop
  if cleared>0 then
    score=score+awards(min(4,cleared))*level
    lineCount=lineCount+cleared : level=1+int(lineCount/10)
  end if
return
