! Ninety seconds of simulated input and physics through the real game routines.
testName$='Repeated game ticks and rendering remain in bounds'
testKeys$='ADW S D A '
score=0 : lives=3 : level=1 : gameTime=0 : dt=.05 : gameOver=0
gosub GameInit
for testTick=1 to 1800
  gameTime=gameTime+dt
  testKeyPos=1+mod(testTick,len(testKeys$)) : key$=testKeys$(testKeyPos:testKeyPos)
  gosub GameInput : gosub GameTick
  if mod(testTick,50)=0 then
    mat pixels$=('  ') : mat ink=(1)
    gosub GameRender
    for testRow=1 to 28
      for testCol=1 to 40
        passed=(ink(testRow,testCol)>=1 and ink(testRow,testCol)<=17) : gosub Assert
      next testCol
    next testRow
  end if
  if lives<=0 or gameOver then
    score=0 : lives=3 : level=1 : gameTime=0 : gameOver=0
    gosub GameInit
  end if
next testTick
print #20: 'RESULT: '&str$(checks)&' checks, '&str$(failures)&' failures'
close #20:
execute 'system'
stop
Assert: !
  checks=checks+1
  if passed=0 then
    failures=failures+1 : print #20: 'FAIL: '&testName$
  end if
return
include: Common\Support.panda
